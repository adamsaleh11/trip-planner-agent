# Trip Journal backend configuration.
# Copy to .env and fill in. No secrets are committed.

# Google Cloud / Firestore
GCP_PROJECT=trip-agent-498919
FIRESTORE_DATABASE=(default)

# Path to a Firebase service-account JSON used for ID-token verification.
# Leave unset to use Application Default Credentials (gcloud auth / metadata).
FIREBASE_CREDENTIALS_PATH=

# Gmail sender — reserved for T1.2 (invite emails)
GMAIL_SENDER_ADDRESS=
GMAIL_SENDER_CREDENTIALS_PATH=

# ADK itinerary generation
AGENT_MODEL=gemini-2.5-flash
AGENT_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GROQ_API_KEY=
AGENT_CATEGORY_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct
AGENT_CATEGORY_MODEL_FALLBACKS=gemini-2.5-flash-lite
AGENT_COORDINATOR_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct
AGENT_COORDINATOR_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
